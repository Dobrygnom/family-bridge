{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "message_to_peer": { "type": "string" },
    "owner_question": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["continue", "complete", "paused", "unsafe"]
    },
    "topics": { "type": "array", "items": { "type": "string" } },
    "private_report": { "type": "string" },
    "shared_summary": { "type": "string" }
  },
  "required": [
    "message_to_peer",
    "owner_question",
    "status",
    "topics",
    "private_report",
    "shared_summary"
  ]
}
